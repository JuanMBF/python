# Copiá este archivo como .env y ajustá los valores.

# Base de datos. Por defecto, un archivo SQLite local.
DATABASE_URL=sqlite:///./helpdesk.db

# Clave para firmar los tokens JWT: usá un valor largo y aleatorio en producción.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Zona horaria usada para agrupar las métricas diarias.
TIMEZONE=America/Argentina/Buenos_Aires
